{
  "name": "tube-stremio-addon",
  "version": "1.0.0",
  "description": "Self-hosted Stremio addon for Real-Debrid: DMM-style cloud library + torrent search, remote-friendly.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "stremio",
    "addon",
    "real-debrid",
    "debrid",
    "torrentio"
  ],
  "license": "MIT",
  "dependencies": {
    "stremio-addon-sdk": "^1.6.10",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
