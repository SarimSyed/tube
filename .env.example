# Server
PORT=7000

# Optional: a single Real-Debrid API token baked into the server.
# If set, requests may omit the token from the URL path and use this instead.
# Leave empty to use the token-in-URL model (one install URL per token).
RD_API_KEY=

# Optional: force the base URL used in generated install links and image URLs
# (useful behind a reverse proxy). Defaults to the request's host.
BASE_URL=

# Optional poster enrichment for extra catalogs. Standard title playback uses Cinemeta.
TMDB_API_KEY=

# By default Tube adds streams to normal Stremio titles without separate catalogs.
SHOW_LIBRARY_CATALOGS=false
# Advanced torrent-index search, for titles missing from your normal catalogs.
SHOW_SEARCH_CATALOGS=false

# Torrent search index (Zilean instance). Leave empty when using the bundled
# Zilean compose profile (it defaults to http://zilean:8181 inside the network).
# Point at any other Zilean instance to use it instead.
ZILEAN_URL=
# API key for Zilean's authenticated endpoints (checkcached). Optional; enables
# cache prefiltering so Tube only adds already-cached torrents.
ZILEAN_API_KEY=

# Optional Torznab endpoint (Jackett/Prowlarr) + API key as an extra search provider.
TORZNAB_URL=
TORZNAB_API_KEY=

# Show torrents that are NOT instantly cached on Real-Debrid (tagged "uncached").
# Defaults to false — only instantly-playable results are shown.
INCLUDE_UNCACHED=true

# Time-to-live (seconds) for cached Real-Debrid / TMDB responses.
CACHE_TTL_SECONDS=120

# Writable dir for persisted state (negative cache). Default: /app/data inside the container.
# DATA_DIR=/app/data

# --- RD Search backend (Zilean fork, docker compose --profile search up) ---
# Password for the bundled Zilean Postgres database. CHANGE THIS from the default.
POSTGRES_PASSWORD=postgres
# Optional host port for the Zilean API/dashboard (default 8184).
ZILEAN_PORT=8184
